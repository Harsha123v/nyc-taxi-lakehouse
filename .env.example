# Copy to .env and fill in. .env is gitignored. Never put AWS keys in this file:
# AWS credentials live in your local AWS CLI profile (~/.aws), not in the repo.

# ---- AWS ----
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
# Profile that holds the least-privilege pipeline user's credentials (created by infra/setup_aws.sh)
AWS_PROFILE=nyc-taxi-pipeline
# Globally unique, lowercase. Example: nyc-taxi-lake-ab12cd
BUCKET=nyc-taxi-lake-change-me

# ---- Dataset ----
YEAR=2025
MONTH=1

# ---- Polaris (local Docker) ----
POLARIS_URI=http://localhost:8181/api/catalog
POLARIS_MGMT_URI=http://localhost:8181/api/management/v1
POLARIS_HEALTH_URI=http://localhost:8182/q/health
# Root credentials Polaris bootstraps with. Local only; change if you like.
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me-local-only
# Polaris catalog (warehouse) name and Iceberg namespace
POLARIS_CATALOG=nyc_taxi_lake
ICEBERG_NAMESPACE=nyc_taxi
# POLARIS_CLIENT_ID / POLARIS_CLIENT_SECRET for the Spark principal are written
# to .polaris.env by `make polaris-bootstrap` (also gitignored).

# ---- Spark ----
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g

# ---- Snowflake (only for scripts/run_snowflake_queries.py) ----
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_USER=your_user
# Use ONE of: key-pair file (recommended) or a password / programmatic access token
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_DATABASE=NYC_TAXI
SNOWFLAKE_SCHEMA=ANALYTICS
